{
  "name": "Celestial Nav Explorer",
  "short_name": "CelNav",
  "description": "Learn marine celestial navigation by seeing, simulating and practising it. Educational use only, not for navigation.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1d33",
  "theme_color": "#0b1d33",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
